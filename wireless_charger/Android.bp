aidl_interface {
    name: "vendor.google.wireless_charger",

    srcs: [
        "vendor/google/wireless_charger/*.aidl",
    ],

    stability: "vintf",
    owner: "google",

    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: true,
            platform_apis: true,
        },
        ndk: {
            enabled: false,
        },
    },
    frozen: false,
}
